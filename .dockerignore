**/__pycache__
*.py[cod]
*.egg-info

.idea
.vscode

.git
.gitignore
.dockerignore

tests/
deploy/
docs/

pyproject.toml
requirements-dev.txt
test_main.http
README.md

*.log
audit.jsonl
.pytest_cache
.coverage
htmlcov

.env
.env.*
kubeconfig
*.kubeconfig
